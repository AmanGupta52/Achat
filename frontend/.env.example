# URL of the backend API (must be https:// for the Android app)
VITE_API_BASE_URL=http://localhost:5000

# Optional — the Google OAuth *Web* client id. Enables "Continue with Google" on the website and in the Android app.
# Leave empty to hide the button. Setup steps: see "Google sign-in" in the main README.
VITE_GOOGLE_CLIENT_ID=
