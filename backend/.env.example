PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/achat
JWT_SECRET=change_me_to_a_long_random_string

# 64 hex characters (32 bytes) used to encrypt messages. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_SECRET=

# Frontend origin(s) allowed by CORS / Socket.io (comma-separated)
CLIENT_URL=http://localhost:5173

# Gmail account used to send OTP emails (use an App Password, not your real password)
EMAIL_USER=
EMAIL_PASS=

# Optional — only needed for "Sign in with Google"
GOOGLE_CLIENT_ID=

# Optional — set to 1 when running behind a reverse proxy (Render, Nginx, Heroku…)
# TRUST_PROXY=1
