PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/achat
JWT_SECRET=change_me_to_a_long_random_string

# 64 hex characters (32 bytes) used to encrypt messages. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_SECRET=

# Frontend origin(s) allowed by CORS / Socket.io (comma-separated). The Android app is allowed automatically.
CLIENT_URL=http://localhost:5173

# ── Emails (sign-up code, password reset, welcome, …) via EmailJS ──────────────────────────────
# Step-by-step guide + the template: backend/emailjs/README.md
# Leave empty while developing: emails are then printed in the terminal.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# needed when "Use Private Key" is enabled in EmailJS → Account → Security
EMAILJS_PRIVATE_KEY=

# ── Google sign-in (optional) ───────────────────────────────────────────────────────────────
# Website button: GOOGLE_CLIENT_ID only.   Android app: also needs GOOGLE_CLIENT_SECRET (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public https URL of THIS backend, used for Google's redirect (…/api/auth/google/callback).
# On Render it is detected automatically; set it if you use a custom domain.
# BACKEND_PUBLIC_URL=https://your-app.onrender.com

# Optional — max minutes a sent message can still be edited (default 15)
# EDIT_WINDOW_MINUTES=15

# Optional — run several backend instances: Socket.io + rate limiter are shared through Redis
# REDIS_URL=redis://localhost:6379

# Optional — keep Render's free tier awake by pinging /health every 10 min.
# On Render this works automatically (RENDER_EXTERNAL_URL). Set KEEP_ALIVE=false to disable.
# KEEP_ALIVE_URL=https://your-app.onrender.com

# Optional — set to 1 when running behind a reverse proxy (Render, Nginx, Heroku…)
# TRUST_PROXY=1
